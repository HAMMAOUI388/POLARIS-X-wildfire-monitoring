DATABASE_URL=postgresql+psycopg://polaris:change-me@localhost:55432/polaris_x
TEST_DATABASE_URL=

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set CORS_ALLOW_PRIVATE_NETWORK=true when the Next.js dev server is accessible
# from a non-loopback interface (e.g. Tailscale/VPN). This enables Chrome's
# Private Network Access (PNA) preflight so the browser can reach 127.0.0.1:5000.
# Also add any non-loopback dev origin to CORS_ORIGINS above.
CORS_ALLOW_PRIVATE_NETWORK=false

# Geographic integrations (configure production providers and policies explicitly)
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOGRAPHY_USER_AGENT=POLARIS-X/0.1 (contact: admin@example.com)
GEOGRAPHY_PROVIDER_TIMEOUT=5
GEOGRAPHY_PROVIDER_RETRIES=1
ROUTING_PROVIDER=osrm
OSRM_URL=
GRAPHHOPPER_URL=https://graphhopper.com/api/1
GRAPHHOPPER_API_KEY=
MAP_STYLE_URL=
MAP_ATTRIBUTION=© OpenStreetMap contributors
# Weather data ingestion (Open-Meteo)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_API_KEY=
OPEN_METEO_COMMERCIAL=false
WEATHER_ATTRIBUTION=Weather data by Open-Meteo.com (CC-BY 4.0, https://doi.org/10.5281/zenodo.7970649)
WEATHER_MAX_AGE_FORECAST_SECONDS=10800
WEATHER_MAX_AGE_ERA5_SECONDS=604800

# NASA FIRMS active fire data ingestion
# Get your free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key
NASA_FIRMS_API_KEY=
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov
